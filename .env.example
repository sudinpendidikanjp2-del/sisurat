# ============================================================================
# SiSurat — contoh konfigurasi environment. Salin ke apps/api/.env (atau set di
# secret manager). JANGAN commit file .env berisi secret sungguhan.
# Semua variabel bersifat opsional untuk pengembangan lokal: nilai default sudah
# cocok dengan docker-compose.yml.
# ============================================================================

# --- Umum -------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Origin aplikasi web (untuk tautan di notifikasi/dokumentasi)
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Default (bila kosong): postgresql://sisurat:sisurat@localhost:5432/sisurat?schema=public
# WAJIB diisi di production.
DATABASE_URL=

# --- Sesi & keamanan ----------------------------------------------------------
SESSION_TTL_HOURS=12
# true di production (wajib HTTPS). Mengaktifkan cookie Secure, HSTS, upgrade-insecure-requests.
COOKIE_SECURE=false
# true bila API berada di belakang reverse proxy (nginx/Caddy) agar IP klien benar.
TRUST_PROXY=false

# --- Penyimpanan dokumen privat ----------------------------------------------
# Direktori di luar web root; hanya dapat dibaca proses API/worker.
DOCUMENT_STORAGE_PATH=./storage

# --- Provider AI (kunci hanya di server; tidak pernah dikirim ke browser) ------
# Pengiriman dokumen ke provider eksternal tetap NONAKTIF sampai admin menyetujui
# provider di menu Konfigurasi & AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Provider utama awal saat seed pertama (GEMINI | CLAUDE | TESSERACT)
AI_PROVIDER=GEMINI

# --- OCR lokal (opsional; butuh paket tesseract-ocr, tesseract-ocr-ind, poppler-utils)
TESSERACT_PATH=tesseract
TESSERACT_LANG=ind+eng
PDFTOPPM_PATH=pdftoppm

# --- Worker -----------------------------------------------------------------
WORKER_POLL_MS=2000
# true = proses job di dalam proses API (cukup untuk dev satu proses)
WORKER_INLINE=false

# --- Seed -------------------------------------------------------------------
# Bila kosong, kata sandi acak dibuat dan ditampilkan sekali di terminal.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
# Data contoh (unit, pengguna per peran, templat CONTOH). Selalu dilewati di production.
SEED_DEMO_DATA=true
