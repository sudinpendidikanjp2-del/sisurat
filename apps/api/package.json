{
  "name": "@sisurat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "worker:dev": "tsx watch --clear-screen=false src/worker.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx src/seed/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@google/genai": "^2.29.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sisurat/shared": "*",
    "docxtemplater": "^3.71.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.16.3",
    "pizzip": "^3.2.0",
    "unpdf": "^1.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "prisma": "^7.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vitest": "~4.0.18"
  }
}
